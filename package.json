{
  "name": "plus-launcher",
  "version": "1.19.0",
  "description": "Plus Launcher - Minecraft launcher with Microsoft login, all versions, Fabric/Quilt/Forge/NeoForge and built-in Modrinth + CurseForge mod browser",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/*.test.js\"",
    "key": "node scripts/make-embedded-key.js",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win -p never",
    "build:linux": "electron-builder --linux -p never",
    "build:mac": "electron-builder --mac -p never",
    "release": "electron-builder --win -p never",
    "publish": "electron-builder --win -p always",
    "check-ms": "node scripts/check-ms-auth.js"
  },
  "author": "Plus",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.plus.launcher",
    "productName": "Plus Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "funnyazsupport-ship-it",
        "repo": "Plus-launcher"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "PlusLauncher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Plus Launcher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Plus Launcher",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "artifactName": "PlusLauncher-${version}-${arch}.${ext}",
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "artifactName": "PlusLauncher-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "Лаунчер Minecraft со всеми версиями, модами и загрузчиками",
      "description": "Plus Launcher — лаунчер Minecraft: все версии Mojang, Fabric, Quilt, Forge и NeoForge, моды с Modrinth и CurseForge, скины, вход через Ely.by.",
      "maintainer": "Plus Launcher <noreply@users.noreply.github.com>",
      "executableName": "plus-launcher",
      "desktop": {
        "StartupWMClass": "Plus Launcher",
        "MimeType": "application/x-plus-modpack;",
        "Keywords": "minecraft;launcher;mods;игра;майнкрафт;",
        "Comment": "Лаунчер Minecraft со всеми версиями и модами"
      },
      "artifactName": "PlusLauncher-${version}-${arch}.${ext}",
      "mimeTypes": [
        "application/x-plus-modpack"
      ]
    },
    "fileAssociations": [
      {
        "ext": "plusmodpack",
        "name": "Plus Launcher modpack",
        "description": "Сборка Plus Launcher",
        "icon": "build/icon",
        "role": "Viewer",
        "mimeType": "application/x-plus-modpack"
      }
    ],
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libsecret"
      ]
    }
  }
}
